# Copy to .env.local and fill in. All values are optional.
# .env* is gitignored - never commit real keys.

# Google Analytics measurement ID. Omit to disable GA (Vercel Analytics still works).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Without this the portfolio assistant answers from its local
# knowledge base. Set it to route answers through Gemini instead.
GEMINI_API_KEY=

# Optional override for the primary Gemini model.
GEMINI_MODEL=
